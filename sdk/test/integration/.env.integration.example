# Copia este archivo a sdk/.env (o sdk/.env.local) para correr
# `npm run test:integration`. Requiere una wallet de TESTNET con fondos —
# nunca uses una key con fondos reales aquí.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/TU_API_KEY
TEST_PRIVATE_KEY=0xTU_PRIVATE_KEY_DE_UNA_WALLET_DE_TESTNET
