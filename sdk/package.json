{
    "name": "@zero-two-labs/payngo",
    "version": "0.4.3",
    "description": "SDK for Pay'n Go — stablecoin payment links, routing, and gasless sponsorship on Ethereum Sepolia",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc",
        "prepublishOnly": "npm run build && npm test",
        "test": "jest",
        "test:integration": "tsx test/integration/sdk.integration.ts",
        "dev": "tsc --watch",
        "demo": "ts-node src/agent-demo.ts"
    },
    "engines": {
        "node": ">=18"
    },
    "keywords": [
        "ethereum",
        "stablecoin",
        "payments",
        "usdc",
        "web3",
        "ai-agent"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/usainbluntmx/pay-n-go.git",
        "directory": "sdk"
    },
    "license": "MIT",
    "peerDependencies": {
        "viem": "^2.0.0"
    },
    "devDependencies": {
        "@types/jest": "^29.0.0",
        "@types/node": "^20.0.0",
        "dotenv": "^17.4.2",
        "jest": "^29.0.0",
        "ts-jest": "^29.0.0",
        "ts-node": "^10.0.0",
        "tsx": "^4.7.0",
        "typescript": "^5.0.0",
        "viem": "^2.0.0"
    }
}
